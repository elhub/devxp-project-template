# EditorConfig helps developers define and maintain consistent coding styles between different editors and IDEs
# editorconfig.org

# This file is the top-most EditorConfig file
root = true

# All Files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160

# Git
[.gitmodules]
indent_style = tab
max_line_length = off

# Go
[{go.mod,go.sum,*.go}]
indent_style = tab

# JSON
[*.json]
indent_size = 2
max_line_length = off

# Kotlin
[*.{kt,kts}]
ij_continuation_indent_size = 4

# Makefile
[{Makefile,**.mk}]
indent_style = tab

# PlantUML
[*.{puml,plantuml}]
indent_size = 2

# Rego
[*.rego]
indent_size = 2
max_line_length = off

# Shell
[*.sh]
indent_size = 2

# SQL
[*.sql]
indent_size = 2
max_line_length = off

# TOML
[*.toml]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# XML
[*.xml]
indent_size = 2
